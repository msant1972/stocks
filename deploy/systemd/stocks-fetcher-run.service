[Unit]
Description=Stocks — cargas iniciais pedidas pela aplicação
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=stocks-svc
Group=stocks-svc
EnvironmentFile=/etc/stocks/stocks.env
WorkingDirectory=/opt/stocks/engines/fetcher
ExecStart=/opt/stocks/engines/fetcher/.venv/bin/python -m fetcher run
TimeoutStartSec=30min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

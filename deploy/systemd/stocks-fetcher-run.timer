[Unit]
Description=Stocks — processar cargas iniciais a cada 5 minutos

[Timer]
# A cada 5 minutos, mas sem bater entre o minuto 19 e o 29: aí correm a recolha horária (minuto 20) e a Automação (minuto 23).
OnCalendar=*:04,09,14,29,34,39,44,49,54,59
Persistent=false

[Install]
WantedBy=timers.target

[Unit]
Description=Stocks — recolha diária das cotações e alertas por email
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=oneshot
User=stocks-svc
Group=stocks-svc
EnvironmentFile=/etc/stocks/stocks.env
# Cache de cookies e fusos do yfinance: a home (/opt/stocks) é só de leitura.
Environment=XDG_CACHE_HOME=/var/lib/stocks/cache
ExecStart=/opt/stocks/deploy/bin/daily.sh
TimeoutStartSec=2h
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/stocks

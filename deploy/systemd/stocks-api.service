[Unit]
Description=Stocks — API e frontend
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=stocks-svc
Group=stocks-svc
EnvironmentFile=/etc/stocks/stocks.env
Environment=STOCKS_FETCH_TRIGGER_FILE=/var/lib/stocks/fetch-request
Environment=STOCKS_ALERTS_PYTHON=/opt/stocks/engines/alerts/.venv/bin/python
# Heap do processo principal; os cálculos das estratégias correm em worker threads (um por núcleo), dentro do MemoryMax.
Environment=NODE_OPTIONS=--max-old-space-size=1024
WorkingDirectory=/opt/stocks/api
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5
# Endurecimento
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/stocks
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=1536M

[Install]
WantedBy=multi-user.target

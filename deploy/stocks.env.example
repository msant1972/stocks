# Configuração de produção da aplicação Stocks.
# Copiado para /etc/stocks/stocks.env (dono root:stocks-svc, modo 640). Nunca versionar este ficheiro preenchido.

# Base de dados
STOCKS_DB_HOST=127.0.0.1
STOCKS_DB_PORT=3306
STOCKS_DB_USER=stocks
STOCKS_DB_PASSWORD=
STOCKS_DB_NAME=stocks

# API
STOCKS_API_HOST=127.0.0.1
STOCKS_API_PORT=3000
STOCKS_PUBLIC_ORIGIN=https://stocks.graus.pt
STOCKS_FRONTEND_DIST=/opt/stocks/frontend/dist
STOCKS_INITIAL_CAPITAL=1000000.00
STOCKS_MAX_QUOTE_AGE_DAYS=7

# SMTP para os alertas. Preferencialmente configurado em Definições (guardado na BD, palavra-passe cifrada
# com /etc/stocks/secret.key); estas variáveis só são usadas se não houver configuração em Definições.
# Sem nenhuma das duas, os alertas correm em --dry-run e não enviam emails.
STOCKS_SMTP_HOST=
STOCKS_SMTP_PORT=587
STOCKS_SMTP_SECURITY=starttls
STOCKS_SMTP_USER=
STOCKS_SMTP_PASSWORD=
STOCKS_SMTP_FROM="Stocks <alertas@graus.pt>"

# Ligação à SAXO Bank (token de cada utilizador em Definições). Só a conta de simulação (SIM);
# a conta real continua recusada enquanto isto não for "true" (decisão expressa).
STOCKS_SAXO_ALLOW_LIVE=false
# Segundos entre as verificações das ordens SAXO abertas (avisos por email); 0 desliga.
STOCKS_SAXO_WATCH_SECONDS=60
# Avisos instantâneos das ordens SAXO por streaming (WebSocket); com "false" fica só a verificação de 60 s.
STOCKS_SAXO_STREAMING=true

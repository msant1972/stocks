# Configuração de produção da aplicação Stocks.
# Copiado para /etc/stocks/stocks.env (dono root:stocks, modo 640). Nunca versionar este ficheiro preenchido.

# Base de dados
STOCKS_DB_HOST=127.0.0.1
STOCKS_DB_PORT=3306
STOCKS_DB_USER=stocks
STOCKS_DB_PASSWORD=
STOCKS_DB_NAME=stocks

# API
STOCKS_API_HOST=127.0.0.1
STOCKS_API_PORT=3000
STOCKS_PUBLIC_ORIGIN=https://stocks.graus.pt
STOCKS_FRONTEND_DIST=/opt/stocks/frontend/dist
STOCKS_INITIAL_CAPITAL=1000000.00
STOCKS_MAX_QUOTE_AGE_DAYS=7

# SMTP para os alertas (sem STOCKS_SMTP_HOST, os alertas correm em --dry-run e não enviam emails)
STOCKS_SMTP_HOST=
STOCKS_SMTP_PORT=587
STOCKS_SMTP_SECURITY=starttls
STOCKS_SMTP_USER=
STOCKS_SMTP_PASSWORD=
STOCKS_SMTP_FROM="Stocks <alertas@graus.pt>"

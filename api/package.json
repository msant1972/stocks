{
  "name": "stocks-api",
  "version": "0.1.0",
  "private": true,
  "description": "Middleware/API da plataforma de simulação de acções",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env src/server.js",
    "dev": "node --env-file-if-exists=../.env --watch src/server.js",
    "cli": "node --env-file-if-exists=../.env src/cli.js",
    "openapi": "node scripts/openapi.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "mysql2": "3.24.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "vitest": "5.0.5"
  }
}
